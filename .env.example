# Project Nemo — environment variables
# Copy to .env and fill in real values

# ── Host / domain ──────────────────────────────────────────────
SERVER_DOMAIN=your-REDACTED-HOST-domain.com   # public subdomain base
LAN_IP=192.168.1.100                         # REDACTED-HOST LAN IP

# ── Home Assistant ─────────────────────────────────────────────
HA_URL=http://homeassistant:8123
HA_TOKEN=your_ha_long_lived_access_token

# ── InfluxDB ───────────────────────────────────────────────────
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change_me_influx
INFLUXDB_INIT_ORG=nemo
INFLUXDB_INIT_BUCKET=aquarium
INFLUXDB_INIT_ADMIN_TOKEN=change_me_influx_token
INFLUXDB_URL=http://influxdb:8086

# ── Mosquitto MQTT ─────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=nemo
MQTT_PASSWORD=change_me_mqtt

# ── Nemo API ───────────────────────────────────────────────────
API_SECRET_KEY=change_me_api_secret
LOG_LEVEL=info

# ── Nginx / auth ───────────────────────────────────────────────
# Generate with: htpasswd -nb nemo yourpassword
HTPASSWD_ENTRY=nemo:$apr1$XXXXXXXX$XXXXXXXXXXXXXXXXXXXXXXX

# ── Telegram (via n8n webhooks) ────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_ALERT=your_n8n_alert_webhook_id
N8N_WEBHOOK_REMINDER=your_n8n_reminder_webhook_id
N8N_WEBHOOK_SUPPLY=your_n8n_supply_webhook_id
N8N_WEBHOOK_DAILY=your_n8n_daily_webhook_id
TELEGRAM_LANG=both   # pl | en | both

# ── Tapo P110 entity IDs (set after HA autodiscovers them) ─────
TAPO_FILTER_ENTITY=switch.tapo_filter
TAPO_HEATER_ENTITY=switch.tapo_heater
TAPO_LIGHT_ENTITY=switch.tapo_light
TAPO_AIR_ENTITY=switch.tapo_air_pump

# ── Fluval BLE ─────────────────────────────────────────────────
FLUVAL_BLE_MAC=AA:BB:CC:DD:EE:FF   # MAC from Fluval app BLE scan

# ── ESPHome sensor entity IDs (set after ESP32 joins HA) ───────
ESPHOME_TEMP_ENTITY=sensor.nemo_sensor_temperature
ESPHOME_PH_ENTITY=sensor.nemo_sensor_ph
