# Secrets
.env
homeassistant/config/secrets.yaml
firmware/secrets.yaml

# Live Zigbee network key + MQTT credentials (not env-var driven — real values
# live only on the deployment host; only the .example template is tracked)
zigbee2mqtt/config/configuration.yaml
mosquitto/config/passwd

# HA runtime state
homeassistant/config/.storage/
homeassistant/config/.ha_run.lock
homeassistant/config/.HA_VERSION
homeassistant/config/home-assistant.log
homeassistant/config/home-assistant.log.*
homeassistant/config/home-assistant.log.fault

# zigbee2mqtt runtime
zigbee2mqtt/config/log/
zigbee2mqtt/config/migration*.log

# mosquitto data (permission-restricted)
mosquitto/data/
mosquitto/log/

# Python
__pycache__/
*.pyc
*.pyo

# User-uploaded/fetched obsada species images (user content, not source - same
# reasoning as .env)
api/static/obsada_images/

# Node / Vue build artifacts
ui/node_modules/
ui/dist/

# OneDrive conflict files
*\(#*conflict*\)*
*\(#*Name clash*\)*

# graphify
graphify-out/cache/
graphify-out/*.html

# Ad hoc HA config backups (git history is the real backup now - see heimdall/PHASE1_5_HARDENING_AND_PHASE2_PLAN.md backlog #1)
homeassistant/config/*.bak-*
homeassistant/config/*.bak
mosquitto/config/*.bak-*
zigbee2mqtt/config/*.bak-*

# Local backups, runtime databases and editor state (audit cleanup 2026-11-10)
backups/
.cursor/
.env.bak-*
api/nemo.db
homeassistant/config/home-assistant_v2.db*
homeassistant/config/.cache/
homeassistant/config/tts/
homeassistant/config/www/
# Third-party HA integrations (installed from upstream, not our source)
homeassistant/config/custom_components/frigate/
homeassistant/config/custom_components/meross_lan/
homeassistant/config/custom_components/sonoff/
# zigbee2mqtt runtime state (holds the network key)
zigbee2mqtt/config/coordinator_backup.json
zigbee2mqtt/config/database.db*
