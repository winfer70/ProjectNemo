      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        480,
        80
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.message.text.trim() }}",
        "rules": {
          "rules": [
            {
              "value2": "/status",
              "output": 0
            },
            {
              "value2": "/filter on",
              "output": 1
            },
            {
              "value2": "/filter off",
              "output": 2
            },
            {
              "value2": "/heater on",
              "output": 3
            },
            {
              "value2": "/heater off",
              "output": 4
            },
            {
              "value2": "/pump on",
              "output": 5
            },
            {
              "value2": "/pump off",
              "output": 6
            },
            {
              "value2": "/feed",
              "output": 7
            }
          ]
        },
        "fallbackOutput": 8
      }
    },
    {
      "id": "n-http-0",
      "name": "HTTP Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        -400
      ],
      "parameters": {
        "method": "GET",
        "url": "http://10.0.0.103:8000/api/devices",
        "options": {}
      }
    },
    {
      "id": "n-code-0",
      "name": "Format Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -400
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = items[0].json;\nconst devs = Array.isArray(raw) ? raw : [raw];\nconst lines = devs.map(d => '  ' + (d.entity_id||d.name||'?') + ': ' + (d.state||d.status||'?'));\nconst msg = 'Aquarium Status:\\n' + lines.join('\\n');\nreturn [{ json: { message: msg } }];"
      }
    },
    {
      "id": "n-tg-0",
      "name": "Reply Status",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
